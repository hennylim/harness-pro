# ── LLM Provider ──────────────────────────────────────────────────────────────
# Supported: OLLAMA | OPENAI | ANTHROPIC | AZURE | GEMINI
AI_PROVIDER=OLLAMA
AI_MODEL=qwen2.5-coder:7b
AI_BASE_URL=http://localhost:11434/v1
AI_API_KEY=ollama

# JSON 출력 모드 (AUTO 권장 – 서버 능력 자동 감지)
# auto | json_object | json_schema | plain_prompt
AI_JSON_MODE=auto

AI_TEMPERATURE=0.0
AI_MAX_TOKENS=4096
AI_TIMEOUT_SECONDS=120
AI_MAX_RETRIES=3

# ── LM Studio (AI_PROVIDER=OPENAI, 로컬 LM Studio 사용 시) ─────────────────────
# LM Studio 는 json_object 를 지원하지 않으므로 AI_JSON_MODE=json_schema 권장.
# AI_PROVIDER=OPENAI
# AI_MODEL=<lm-studio-model-name>
# AI_BASE_URL=http://localhost:1234/v1
# AI_API_KEY=lm-studio
# AI_JSON_MODE=json_schema

# ── Gemini (AI_PROVIDER=GEMINI 일 때) ─────────────────────────────────────────
# Google AI Studio: https://aistudio.google.com/apikey
# GEMINI_API_KEY=AIza...
# AI_MODEL=gemini-2.5-flash-preview-05-20   # 또는 gemini-2.5-pro-preview-06-05

# ── Target Language ───────────────────────────────────────────────────────────
# Supported: python | bash | c | cpp
# 새 언어 추가 방법은 README 의 "언어 확장 가이드" 참고
TARGET_LANGUAGE=python

# ── Adaptive chunking ─────────────────────────────────────────────────────────
# 이 줄 수 이상으로 예상되는 파일은 섹션별 분할 생성 (기본 80)
# 작은 LLM 사용 시 낮게 설정 (예: 60), 큰 LLM 은 높게 설정 (예: 150)
CHUNK_THRESHOLD_LINES=80
# 빌드 실패 시 자동 수정 재시도 횟수
BUILD_FIX_RETRIES=2

# ── Agent Behaviour ────────────────────────────────────────────────────────────
DRY_RUN=True
WORKSPACE_DIR=./sandbox_workspace
GIT_REPOSITORY_URLS=
GIT_REPOSITORIES_DIR=repositories
REPO_ANALYSIS_DIR=.repo_analysis
MAX_SELF_HEAL_ATTEMPTS=3
MAX_TASKS_PER_RUN=50

# ── Code Quality ───────────────────────────────────────────────────────────────
# Python 전용 (다른 언어는 센서가 자체 기본값 보유)
LINT_BACKEND=ruff
LINT_IGNORE_CODES=E501,W292,W391

# ── Observability ──────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FORMAT=console         # console | json

# ── Notifications (optional) ───────────────────────────────────────────────────
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
NOTIFY_ON_FAILURE=True
NOTIFY_ON_SUCCESS=False
