# ── LLM Provider ──────────────────────────────────────────────────────────────
# Supported: OLLAMA | OPENAI | ANTHROPIC | AZURE
AI_PROVIDER=OLLAMA
AI_MODEL=qwen2.5-coder:7b
AI_BASE_URL=http://localhost:11434/v1
AI_API_KEY=ollama

# LLM quality / safety knobs
AI_TEMPERATURE=0.0
AI_MAX_TOKENS=4096
AI_TIMEOUT_SECONDS=120
AI_MAX_RETRIES=3

# ── Agent Behaviour ────────────────────────────────────────────────────────────
DRY_RUN=True
WORKSPACE_DIR=./sandbox_workspace
MAX_SELF_HEAL_ATTEMPTS=3
MAX_TASKS_PER_RUN=50

# ── Code Quality ───────────────────────────────────────────────────────────────
LINT_BACKEND=ruff          # ruff | flake8
LINT_IGNORE_CODES=E501,W292,W391

# ── Observability ──────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FORMAT=console         # console | json

# ── Notifications (optional) ───────────────────────────────────────────────────
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
NOTIFY_ON_FAILURE=True
NOTIFY_ON_SUCCESS=False

# ── Gemini (AI_PROVIDER=GEMINI 일 때) ─────────────────────────────────────────
# Google AI Studio: https://aistudio.google.com/apikey
# GEMINI_API_KEY=AIza...
# AI_MODEL=gemini-2.5-flash-preview-05-20   # 또는 gemini-2.5-pro-preview-06-05
